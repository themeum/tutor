# Site under test. Must be a host in WP_TEST_HOSTS.
SITE_URL=http://localhost:8888

# Playwright base URL. Defaults to SITE_URL, then http://localhost:8888.
# E2E_BASE_URL=http://localhost:8888

# Test databases. WP_TEST_DB_NAME must end in _test.
WP_TEST_DB_NAME=local_test
WP_TEST_DB_USER=root
WP_TEST_DB_PASS=root
WP_TEST_DB_HOST=localhost
WP_PHPUNIT_DB_NAME=local_phpunit

# Comma-separated plugin files or slugs. Defaults to tutor, tutor-pro,
# woocommerce, and h5p when present on disk.
# WP_TEST_ACTIVE_PLUGINS=tutor,tutor-pro,woocommerce

# Hosts allowed to select the test database with a header or cookie.
WP_TEST_HOSTS=localhost,127.0.0.1,::1,*.local

# Password for the five seeded accounts: admin, instructor, student,
# student2, and manager.
E2E_PASSWORD=password
